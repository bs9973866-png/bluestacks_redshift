<Window x:Class="Redshift.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="REDSHIFT BlueStacks" Width="1280" Height="760" Background="{StaticResource Bg}" Foreground="White" WindowStartupLocation="CenterScreen">
 <Grid Margin="22"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <StackPanel><TextBlock Text="REDSHIFT" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Crimson}"/><TextBlock Text="BLUESTACKS / CONTROL CENTER" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,28"/><Button Content="DASHBOARD" Click="Dashboard"/><Button Content="GAMING CENTER" Click="Gaming"/><Button Content="STANDOFF 2" Click="Standoff"/><Button Content="PERFORMANCE" Click="Performance"/><Button Content="RESOLUTION" Click="Resolution"/><Button Content="ANDROID MANAGER" Click="Android"/><Button Content="KEYMAPPING" Click="Keymapping"/><Button Content="OVERLAY" Click="Overlay"/><Button Content="MULTI INSTANCE" Click="Instances"/><Button Content="NETWORK" Click="Network"/><Button Content="DIAGNOSTICS" Click="Diagnostics"/><Button Content="SETTINGS" Click="Settings"/></StackPanel>
  <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="18" Padding="28"><ScrollViewer><StackPanel><TextBlock x:Name="Title" Text="Dashboard" FontSize="32" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Foreground="{StaticResource Muted}" Margin="0,5,0,25"/><WrapPanel x:Name="Cards"/><StackPanel x:Name="Content"/></StackPanel></ScrollViewer></Border>
 </Grid>
</Window>
